{
  "datasets": [
    {
      "name": "ds_market",
      "displayName": "Job market (one row per posting)",
      "queryLines": [
        "SELECT *, CASE WHEN recommendation = 'APPLY' THEN 1.0 ELSE 0.0 END AS is_strong_fit\n        FROM workspace.jobpilot.v_job_market"
      ]
    },
    {
      "name": "ds_daily",
      "displayName": "Open postings per day",
      "queryLines": [
        "SELECT d.snapshot_day, d.company, d.open_postings, d.new_postings\n        FROM workspace.jobpilot.gold_postings_daily d"
      ]
    },
    {
      "name": "ds_skills",
      "displayName": "Top 20 required skills in open postings",
      "queryLines": [
        "WITH s AS (\n          SELECT d.job_key, d.skill, m.city, m.domain,\n                 CASE WHEN d.in_profile THEN 'Have it' WHEN d.on_learning_list THEN 'Learning' ELSE 'Gap' END AS skill_status\n          FROM workspace.jobpilot.gold_skill_demand d JOIN workspace.jobpilot.v_job_market m USING (job_key)\n          WHERE m.is_open AND d.requirement = 'must')\n        SELECT * FROM s WHERE skill IN (\n          SELECT skill FROM s GROUP BY skill ORDER BY COUNT(DISTINCT job_key) DESC LIMIT 20)"
      ]
    },
    {
      "name": "ds_gaps",
      "displayName": "Top 15 required skills I don't list",
      "queryLines": [
        "WITH s AS (\n          SELECT d.job_key, d.skill, m.city, m.domain,\n                 CASE WHEN d.on_learning_list THEN 'Learning' ELSE 'Gap' END AS skill_status\n          FROM workspace.jobpilot.gold_skill_demand d JOIN workspace.jobpilot.v_job_market m USING (job_key)\n          WHERE m.is_open AND d.requirement = 'must' AND NOT d.in_profile)\n        SELECT * FROM s WHERE skill IN (\n          SELECT skill FROM s GROUP BY skill ORDER BY COUNT(DISTINCT job_key) DESC LIMIT 15)"
      ]
    },
    {
      "name": "ds_skill_flags",
      "displayName": "Postings asking for Databricks or GenAI",
      "queryLines": [
        "SELECT m.job_key, m.city, m.domain,\n               MAX(CASE WHEN d.skill = 'databricks' THEN 1 ELSE 0 END) AS wants_databricks,\n               MAX(CASE WHEN d.skill IN ('genie', 'llm', 'generative ai') THEN 1 ELSE 0 END) AS wants_genai\n        FROM workspace.jobpilot.v_job_market m LEFT JOIN workspace.jobpilot.gold_skill_demand d USING (job_key)\n        WHERE m.is_open GROUP BY m.job_key, m.city, m.domain"
      ]
    },
    {
      "name": "ds_quality",
      "displayName": "Latest quality checks",
      "queryLines": [
        "SELECT check_name, value, threshold, passed, blocking, detail, checked_at\n        FROM workspace.jobpilot.ops_quality_log\n        QUALIFY ROW_NUMBER() OVER (PARTITION BY check_name ORDER BY checked_at DESC) = 1"
      ]
    },
    {
      "name": "ds_loads",
      "displayName": "Bronze rows loaded per day",
      "queryLines": [
        "SELECT snapshot_day, source, COUNT(*) AS rows_loaded, COUNT(DISTINCT job_key) AS postings\n        FROM workspace.jobpilot.bronze_job_snapshots GROUP BY snapshot_day, source"
      ]
    }
  ],
